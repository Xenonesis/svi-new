# APP_URL: The URL where this applet is hosted.
APP_URL="https://yourdomain.com"

# NEXT_PUBLIC_ANALYTICS_ID: Google Analytics tracking ID (e.g., G-XXXXXXXXXX).
# Leave empty to disable analytics.
NEXT_PUBLIC_ANALYTICS_ID=""

# NEXT_PUBLIC_APP_URL: Public site URL used in absolute links / webhooks.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ── Sentry ────────────────────────────────────────────────────────────────────
# Server-side init config.
SENTRY_DSN=""
# Client-side init config.
NEXT_PUBLIC_SENTRY_DSN=""

# ── Supabase ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL: Your project's Supabase URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Safe to expose in the browser (respects RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: SECRET – never expose to the browser!
# Used server-side only for admin operations (creating users, bypassing RLS).
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# NEXT_PUBLIC_DISABLE_CAPTCHA: Set to 'true' only for local/testing to bypass bot checks.
NEXT_PUBLIC_DISABLE_CAPTCHA="false"

# CRON_SECRET: Secret token for Vercel Cron Jobs (cleanup-registrations, lottery, etc.).
# The cron endpoint checks this via Authorization: Bearer <CRON_SECRET> header.
# Generate a random string: openssl rand -hex 32
CRON_SECRET="your-random-cron-secret-here"

# NEXT_PUBLIC_HCAPTCHA_SITE_KEY: Required for Supabase Auth Captcha bot detection (client-side).
# Use '10000000-ffff-ffff-ffff-000000000001' as the standard test key for local development.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="10000000-ffff-ffff-ffff-000000000001"

# ── AI ────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for the AI chatbot. Get a free key at https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GROQ_MODEL: Model id used by chatbot/email AI routes.
GROQ_MODEL="openai/gpt-oss-120b"

# ── Resend (Email) ────────────────────────────────────────────────────────────
# RESEND_API_KEY: Server-side only. Used for transactional emails.
RESEND_API_KEY="re_your_resend_api_key"

# ADMIN_EMAIL: Where contact form and registration notifications are sent.
ADMIN_EMAIL="admin@yourdomain.com"

# ── Resend Inbound Email ───────────────────────────────────────────────────────
# RESEND_INBOUND_DOMAIN: Domain for receiving incoming emails / replies
#   Step 1: Add MX record in your DNS provider:
#     Type: MX, Host: inbound, Value: mx1.resend.com, Priority: 10
#     Type: MX, Host: inbound, Value: mx2.resend.com, Priority: 20
#   Step 2: Configure inbound domain at https://resend.com/domains → Add Domain
#   Step 3: Set webhook URL in Resend dashboard for the inbound domain:
#     https://yourdomain.com/api/webhooks/resend/incoming
#   Step 4: Copy the signing secret from Resend dashboard → Webhooks
RESEND_INBOUND_DOMAIN="inbound.yourdomain.com"
RESEND_WEBHOOK_SECRET="whsec_..."

# NEXT_PUBLIC_SHOW_RESEND: Set to 'true' to show Resend usage stats in admin
NEXT_PUBLIC_SHOW_RESEND="false"

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_MOCK_SEND="true"
AUTONOMOUS_OUTBOUND_ENABLED="false"
WHATSAPP_TEST_NUMBER_ALLOWLIST="+919876543210"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verification-token"
WHATSAPP_APP_SECRET="replace-with-meta-app-secret"
WHATSAPP_ACCESS_TOKEN="replace-with-meta-system-user-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-meta-phone-number-id"
WHATSAPP_GRAPH_API_VERSION="vXX.X"

# ── IVR / Outgoing Calls ──────────────────────────────────────────────────────
# Optional override for the IVR provider token. If omitted, server uses its own
# hardcoded default; setting this is recommended for per-environment credentials.
IVR_API_KEY=""

# ── PWA Push Notifications ─────────────────────────────────────────────────────
# VAPID keys for web push notifications. Generate:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: Exposed to browser (required for push subscribe).
# VAPID_PRIVATE_KEY: SECRET – never expose to the browser.
# VAPID_EMAIL: Contact email for push notification service.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:info@sviinfrasolutions.com"

# ── GitHub Changelog ───────────────────────────────────────────────────────────
# GITHUB_REPO: "owner/repo" of the repository whose Releases feed powers the
# /changelog page. Defaults to "sviinfrasolutions/svi-website" if unset.
GITHUB_REPO="sviinfrasolutions/svi-website"

# GITHUB_TOKEN: (Optional) Server-side Personal Access Token. Authenticated
# requests raise the rate limit from 60/hr to 5,000/hr. Create a fine-grained
# token with NO scopes (read access is implicit for public repos) at
# https://github.com/settings/tokens. Leave blank for low-traffic deployments.
GITHUB_TOKEN=""


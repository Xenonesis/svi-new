{
  "name": "svi-infra",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "optimize:images": "node scripts/optimize-images.mjs",
    "perf:dev": "node scripts/perf-monitor.mjs",
    "perf:bundle": "cross-env ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "editorconfig": "editorconfig-checker",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "generate-icons": "node scripts/generate-icons.js",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:db-performance": "tsx scripts/test-db-performance.ts",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npx cap build android",
    "cap:run:android": "npx cap run android",
    "cap:assets": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.5",
    "@ai-sdk/react": "^4.0.16",
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.63.0",
    "@serwist/next": "^9.5.11",
    "@serwist/sw": "^9.5.11",
    "@serwist/turbopack": "^9.5.11",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/three": "^0.185.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.15",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "html2canvas-pro": "^2.2.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "recharts": "^3.9.2",
    "resend": "^6.17.1",
    "serwist": "^9.5.11",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "web-push": "^3.6.7",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "postcss": "^8.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "commitlint": "^21.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "editorconfig-checker": "^6.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "typescript": "$typescript",
    "next": {
      "postcss": "^8.5.10"
    },
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "tar": "^7.5.16",
    "minimatch": "^3.1.4",
    "replace": "^1.2.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "bundlesize": [
    {
      "path": "./.next/static/chunks/**/!(_app|_error).js",
      "maxSize": "100KB"
    },
    {
      "path": "./.next/static/css/*.css",
      "maxSize": "40KB"
    },
    {
      "path": "./public/images/*.webp",
      "maxSize": "150KB"
    },
    {
      "path": "./public/images/*.avif",
      "maxSize": "100KB"
    }
  ],
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.10"
  }
}

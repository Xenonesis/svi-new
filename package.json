{
  "name": "svi-infra",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "optimize:images": "node scripts/optimize-images.mjs",
    "perf:dev": "node scripts/perf-monitor.mjs",
    "perf:bundle": "cross-env ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepush": ".husky/pre-push",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "editorconfig": "editorconfig-checker",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "generate-icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:db-performance": "tsx scripts/test-db-performance.ts",
    "cap:sync": "node scripts/sync-capacitor-flavors.mjs && npx cap sync android && node scripts/sync-capacitor-flavors.mjs",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npx cap build android",
    "cap:run:android": "npx cap run android",
    "cap:employee:sync": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=employee npx cap sync android && node scripts/sync-capacitor-flavors.mjs",
    "cap:employee:open": "cross-env CAP_APP_TARGET=employee npx cap open android",
    "cap:employee:run": "cross-env CAP_APP_TARGET=employee npx cap run android",
    "cap:employee:build": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=employee npx cap sync android && node scripts/sync-capacitor-flavors.mjs && cd android && gradlew assembleEmployeeRelease && cd ..",
    "cap:admin:sync": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=admin npx cap sync android && node scripts/sync-capacitor-flavors.mjs",
    "cap:admin:open": "cross-env CAP_APP_TARGET=admin npx cap open android",
    "cap:admin:run": "cross-env CAP_APP_TARGET=admin npx cap run android",
    "cap:admin:build": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=admin npx cap sync android && node scripts/sync-capacitor-flavors.mjs && cd android && gradlew assembleAdminRelease && cd ..",
    "cap:assets": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.30",
    "@ai-sdk/react": "^4.0.80",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@img/sharp-linux-x64": "^0.35.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.70.0",
    "@serwist/next": "^9.5.12",
    "@serwist/sw": "^9.5.12",
    "@serwist/turbopack": "^9.5.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tiptap/extension-color": "^3.30.2",

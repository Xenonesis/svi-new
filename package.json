{
  "name": "svi-infra",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "optimize:images": "node scripts/optimize-images.mjs",
    "perf:dev": "node scripts/perf-monitor.mjs",
    "perf:bundle": "cross-env ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepush": ".husky/pre-push",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "editorconfig": "editorconfig-checker",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "generate-icons": "node scripts/generate-icons.js",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:db-performance": "tsx scripts/test-db-performance.ts",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npx cap build android",
    "cap:run:android": "npx cap run android",
    "cap:assets": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/react": "^4.0.40",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@img/sharp-linux-x64": "^0.35.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.68.0",
    "@serwist/next": "^9.5.12",
    "@serwist/sw": "^9.5.12",
    "@serwist/turbopack": "^9.5.12",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-color": "^3.29.1",
    "@tiptap/extension-highlight": "^3.29.1",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-text-align": "^3.29.1",
    "@tiptap/extension-text-style": "^3.29.1",
    "@tiptap/extension-underline": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.37",
    "canvas-confetti": "^1.9.4",
    "canvg": "^4.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.3.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lucide-react": "^1.27.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "serwist": "^9.5.12",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "web-vitals": "^6.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.12",
    "@next/eslint-plugin-next": "^16.2.12",
    "@parcel/watcher": "^2.6.0",
    "@parcel/watcher-linux-x64-glibc": "^2.6.0",
    "@playwright/test": "^1.62.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.0",
    "@swc/core-linux-x64-gnu": "^1.15.46",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "commitlint": "^21.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "editorconfig-checker": "^6.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "$typescript",
    "serialize-javascript": "^7.0.7",
    "uuid": "^14.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "bundlesize": [
    {
      "path": "./.next/static/chunks/**/*.js",
      "maxSize": "250KB"
    },
    {
      "path": "./.next/static/css/*.css",
      "maxSize": "50KB"
    }
  ]
}

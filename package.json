{
  "name": "svi-infra",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "dev:webpack": "next dev --webpack --port 3001",
    "prebuild": "node scripts/copy-maplibre-assets.mjs && node scripts/optimize-images.mjs",
    "postinstall": "node scripts/copy-maplibre-assets.mjs",
    "build": "tsc --noEmit && next build",
    "build:webpack": "tsc --noEmit && next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "optimize:images": "node scripts/optimize-images.mjs",
    "perf:dev": "node scripts/perf-monitor.mjs",
    "perf:bundle": "cross-env ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepush": ".husky/pre-push",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "editorconfig": "editorconfig-checker",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "generate-icons": "node scripts/generate-icons.mjs && node scripts/generate-og-image.mjs",
    "generate-og": "node scripts/generate-og-image.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:db-performance": "tsx scripts/test-db-performance.ts",
    "cap:sync": "node scripts/sync-capacitor-flavors.mjs && npx cap sync android && node scripts/sync-capacitor-flavors.mjs",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npx cap build android",
    "cap:run:android": "npx cap run android",
    "cap:employee:sync": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=employee npx cap sync android && node scripts/sync-capacitor-flavors.mjs",
    "cap:employee:open": "cross-env CAP_APP_TARGET=employee npx cap open android",
    "cap:employee:run": "cross-env CAP_APP_TARGET=employee npx cap run android",
    "cap:employee:build": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=employee npx cap sync android && node scripts/sync-capacitor-flavors.mjs && cd android && gradlew assembleEmployeeRelease && cd ..",
    "cap:admin:sync": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=admin npx cap sync android && node scripts/sync-capacitor-flavors.mjs",
    "cap:admin:open": "cross-env CAP_APP_TARGET=admin npx cap open android",
    "cap:admin:run": "cross-env CAP_APP_TARGET=admin npx cap run android",
    "cap:admin:build": "node scripts/sync-capacitor-flavors.mjs && cross-env CAP_APP_TARGET=admin npx cap sync android && node scripts/sync-capacitor-flavors.mjs && cd android && gradlew assembleAdminRelease && cd ..",
    "cap:assets": "npx @capacitor/assets generate --android",
    "backup": "node scripts/export-supabase-backup.mjs",
    "backup:task": "powershell -ExecutionPolicy Bypass -File scripts/setup-daily-backup-task.ps1",
    "backup:daemon": "node scripts/backup-daemon.mjs",
    "gitnexus:analyze": "gitnexus analyze",
    "gitnexus:status": "gitnexus status",
    "gitnexus:clean": "gitnexus clean"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.62",
    "@ai-sdk/react": "^4.0.146",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@img/sharp-linux-x64": "^0.35.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.8.0",
    "@serwist/next": "^9.5.13",
    "@serwist/sw": "^9.5.13",
    "@serwist/turbopack": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.142",
    "canvas-confetti": "^1.9.4",
    "canvg": "^4.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "heic-convert": "^2.1.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.5.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.33.0",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@next/eslint-plugin-next": "^16.4.2",
    "@parcel/watcher": "^2.6.0",
    "@parcel/watcher-linux-x64-glibc": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/binding-linux-x64-gnu": "^1.2.5",
    "@swc/core-linux-x64-gnu": "^1.16.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "commitlint": "^21.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "editorconfig-checker": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gitnexus": "^1.6.12",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "nanoid": "3.3.18",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "typescript": "$typescript",
    "serialize-javascript": "^7.0.7",
    "uuid": "^14.0.1",
    "js-yaml": ">=4.3.2",
    "dompurify": ">=3.4.13",
    "browserslist": ">=4.28.7",
    "adm-zip": ">=0.6.1",
    "fast-uri": ">=3.1.8",
    "qs": ">=6.16.0",
    "undici": ">=7.29.1",
    "brace-expansion": ">=5.0.11"
  },
  "resolutions": {
    "js-yaml": ">=4.3.2",
    "adm-zip": ">=0.6.1",
    "undici": ">=7.29.1",
    "brace-expansion": ">=5.0.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --cache --cache-location .eslintcache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "bundlesize": [
    {
      "path": "./.next/static/chunks/**/*.js",
      "maxSize": "250KB"
    },
    {
      "path": "./.next/static/css/*.css",
      "maxSize": "50KB"
    }
  ]
}

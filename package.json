    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.77",
    "canvas-confetti": "^1.9.4",
    "canvg": "^4.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "heic-convert": "^2.1.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.3.9",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.5.0",
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.22.0",
    "serwist": "^9.5.12",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "web-vitals": "^6.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.3.2",
    "@next/eslint-plugin-next": "^16.3.2",
    "@parcel/watcher": "^2.6.0",
    "@parcel/watcher-linux-x64-glibc": "^2.6.0",
    "@playwright/test": "^1.62.1",
    "@rolldown/binding-linux-x64-gnu": "^1.2.5",
    "@swc/core-linux-x64-gnu": "^1.16.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "commitlint": "^21.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "editorconfig-checker": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "nanoid": "3.3.18",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "typescript": "$typescript",
    "serialize-javascript": "^7.0.7",
    "uuid": "^14.0.1",
    "js-yaml": "^4.3.1",
    "dompurify": ">=3.4.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "bundlesize": [
    {
      "path": "./.next/static/chunks/**/*.js",
      "maxSize": "250KB"
    },
    {
      "path": "./.next/static/css/*.css",
      "maxSize": "50KB"
    }
  ]
}
